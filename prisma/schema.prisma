// Generate the JavaScript database client imported from @prisma/client.
generator client {
  provider = "prisma-client-js"
}

// Connect to MongoDB using the private URL supplied through the environment.
datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Restrict account roles to the two supported user journeys.
enum Role {
  CANDIDATE
  EMPLOYER
}

// Shared login identity. Role-specific information lives in a profile.
model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Registration creates only the profile matching the account's role.
  candidateProfile CandidateProfile?
  employerProfile  EmployerProfile?
}

// Store candidate details separately from credentials; unique userId makes the link one-to-one.
model CandidateProfile {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @unique @db.ObjectId
  fullName  String
  headline  String?
  location  String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resumes   Resume[]

  // Resolve the owning user through an ObjectId reference checked by application services.
  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

// Keep immutable file metadata in MongoDB while PDF bytes remain on private disk storage.
model Resume {
  id           String           @id @default(auto()) @map("_id") @db.ObjectId
  candidateId  String           @db.ObjectId
  originalName String
  storageKey   String           @unique
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime         @default(now())
  candidate    CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([candidateId, createdAt])
}

// Store company details for a single employer account with a unique user reference.
model EmployerProfile {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @unique @db.ObjectId
  companyName String
  description String?
  website     String?
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  jobs        Job[]

  // Keep user changes explicit instead of automatically cascading document operations.
  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

// Restrict job filters to the employment arrangements supported by the API.
enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum WorkMode {
  ONSITE
  HYBRID
  REMOTE
}

enum JobStatus {
  OPEN
  CLOSED
}

// Preserve closed listings and their owner for later application tracking.
model Job {
  id                  String          @id @default(auto()) @map("_id") @db.ObjectId
  employerId          String          @db.ObjectId
  title               String
  description         String
  location            String
  employmentType      EmploymentType
  workMode            WorkMode
  status              JobStatus       @default(OPEN)
  applicationSequence Int             @default(0)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  employer            EmployerProfile @relation(fields: [employerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status, createdAt])
  @@index([employerId, createdAt])
}

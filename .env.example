NODE_ENV=development
PORT=5000
DATABASE_URL="mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER/job_board?retryWrites=true&w=majority"
JWT_SECRET=replace-with-a-random-secret
JWT_EXPIRES_IN=1h
UPLOAD_DIR=./storage/resumes
MAX_RESUME_BYTES=5242880
CORS_ORIGIN=http://localhost:3000
TEST_DATABASE_URL="mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER/job_board_test?retryWrites=true&w=majority"
